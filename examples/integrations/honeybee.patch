+import { build } from 'esbuild';
+import { mkdtemp, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { spawnSync } from 'node:child_process';
+const directory = await mkdtemp(join(tmpdir(), 'honeybee-workerkit-'));
+try {
+  const outfile = join(directory, 'workerkit.test.mjs');
+  await build({ entryPoints: ['integration/workerkit-check.ts'], bundle: true, format: 'esm', platform: 'node', target: 'node22', external: ['cloudflare:*'], splitting: true, outdir: directory, entryNames: 'workerkit.test', outExtension: { '.js': '.mjs' } });
+  const result = spawnSync(process.execPath, ['--test', outfile], { stdio: 'inherit' });
+  process.exitCode = result.status ?? 1;
+} finally { await rm(directory, { recursive: true, force: true }); }
