diff --git a/frontend/workerkit-history.ts b/frontend/workerkit-history.ts
new file mode 100644
index 0000000..7550270
--- /dev/null
+++ b/frontend/workerkit-history.ts
@@ -0,0 +1,10 @@
+import { ApiClientError, createApiClient } from '@pengzhendong/worker-kit/web';
+import type { PageList } from '@pengzhendong/worker-kit/contracts';
+export { ApiClientError };
+interface HistoryEntry { id: string; createdAt: string; count: number; seenCount: number }
+const api = createApiClient();
+export function listHistory(scope: string, domain: string) {
+  const query = new URLSearchParams({ scope, page: '1', pageSize: '10', sort: 'createdAt', order: 'desc' });
+  if (domain) query.set('domain', domain);
+  return api<PageList<HistoryEntry> & { currentHistoryId: string | null }>(`/api/admin/history?${query}`);
+}
diff --git a/integration/workerkit-check.ts b/integration/workerkit-check.ts
new file mode 100644
index 0000000..10e94b4
--- /dev/null
+++ b/integration/workerkit-check.ts
@@ -0,0 +1,94 @@
+import assert from 'node:assert/strict';
+import { timingSafeEqual } from 'node:crypto';
+import test from 'node:test';
+import { historyApp } from '../src/workerkit-history';
+import { handleAdminRequest } from '../src/admin.js';
+import { createApiClient, getFormErrors } from '@pengzhendong/worker-kit/web';
+import type { PageList } from '@pengzhendong/worker-kit/contracts';
+
+if (typeof (crypto.subtle as any).timingSafeEqual !== 'function') Object.defineProperty(crypto.subtle, 'timingSafeEqual', { value: timingSafeEqual });
+const origin = 'https://honeybee.example';
+const domain = 'https://source.example';
+class MemoryKV {
+  values = new Map<string, string>(); writes: string[] = [];
+  async get(key: string, type?: string) { const value = this.values.get(key); return value === undefined ? null : type === 'json' ? JSON.parse(value) : value; }
+  async put(key: string, value: string) { this.values.set(key, String(value)); this.writes.push(key); }
+  async delete(key: string) { this.values.delete(key); }
+}
+function setup() {
+  const cache = new MemoryKV();
+  const entries = ['a', 'b', 'c'].map((id, index) => {
+    const key = `subscription:history:v1:outboard:${domain}:${id}`;
+    const createdAt = `2026-10-2${index + 1}T00:00:00.000Z`;
+    const result = { ok: true, count: 1, domain, scope: 'outboard', items: [{ id: 'node', link: 'vmess://private-test-node' }], errors: [] };
+    cache.values.set(key, JSON.stringify({ id, key, createdAt, hash: `hash-${id}`, result }));
+    return { id, key, createdAt, hash: `hash-${id}`, count: 1, seenCount: 1 };
+  });
+  cache.values.set(`subscription:history-index:v1:outboard:${domain}`, JSON.stringify({ entries }));
+  return { cache, env: { ADMIN_USERNAME: 'admin', ADMIN_PASSWORD: 'test-password-for-integration', ADMIN_SESSION_SECRET: 'integration-secret-with-at-least-32-characters', HONEYBEE_CACHE: cache, HONEYBEE_DOMAIN: domain } };
+}
+async function login(env: Record<string, unknown>) {
+  const response = await handleAdminRequest(new Request(`${origin}/login`, { method: 'POST', headers: { Origin: origin }, body: new URLSearchParams({ username: 'admin', password: 'test-password-for-integration' }) }), env);
+  assert.equal(response.status, 303);
+  return response.headers.get('Set-Cookie')!.split(';')[0]!;
+}
+const request = (env: Record<string, unknown>, cookie = '', path = '/api/admin/history', init: RequestInit = {}) => historyApp.fetch(new Request(`${origin}${path}`, { ...init, headers: { Cookie: cookie, Origin: origin, ...init.headers } }), env);
+
+test('new contract accepts Honeybee signed cookies and rejects missing or tampered sessions', async () => {
+  const { env } = setup(); const cookie = await login(env);
+  assert.equal((await request(env)).status, 401);
+  assert.equal((await request(env, cookie + 'tampered')).status, 401);
+  assert.equal((await request(env, cookie)).status, 200);
+  assert.equal((await request({ ...env, HONEYBEE_LOCAL_AUTH_BYPASS: '1' })).status, 401);
+  const failure = await request({ HONEYBEE_LOCAL_AUTH_BYPASS: '1' });
+  assert.equal(failure.status, 503);
+});
+test('bounded history uses the page contract without leaking KV keys or subscription links', async () => {
+  const { env } = setup(); const cookie = await login(env);
+  const response = await request(env, cookie, '/api/admin/history?page=2&pageSize=1&sort=id&order=asc');
+  assert.equal(response.status, 200);
+  const result: PageList<{ id: string }> = await response.json();
+  assert.deepEqual(result.items.map(item => item.id), ['b']);
+  assert.equal(result.total, 3); assert.equal(result.page, 2); assert.equal(result.pageSize, 1);
+  assert.doesNotMatch(JSON.stringify(result), /subscription:history|vmess:|private-test-node|hash-/);
+});
+test('filters and allowed sorting are enforced at the new boundary', async () => {
+  const { env } = setup(); const cookie = await login(env);
+  assert.equal((await request(env, cookie, '/api/admin/history?sort=createdAt%3BDROP&order=asc')).status, 400);
+  assert.equal((await request(env, cookie, '/api/admin/history?pageSize=101')).status, 400);
+  assert.equal((await request(env, cookie, '/api/admin/history?scope=unknown')).status, 422);
+  const filtered = await (await request(env, cookie, '/api/admin/history?q=c')).json();
+  assert.equal(filtered.total, 1); assert.equal(filtered.items[0].id, 'c');
+});
+test('server validation reaches the shared form error helper and retains the input field', async () => {
+  const { env } = setup(); const cookie = await login(env);
+  const client = createApiClient({ baseUrl: origin, fetcher: (async (url, init) => historyApp.fetch(new Request(String(url), { ...init, headers: { ...init?.headers, Cookie: cookie, Origin: origin } }), env)) as typeof fetch });
+  await assert.rejects(client('/api/admin/history/restore', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: '', scope: 'outboard' }) }), (error: any) => {
+    assert.equal(error.status, 422); assert.ok(error.requestId);
+    assert.deepEqual(getFormErrors(error), [{ name: ['id'], errors: ['请选择有效的历史版本'] }]); return true;
+  });
+});
+test('restore reuses the actual Honeybee KV implementation and returns a safe action result', async () => {
+  const { cache, env } = setup(); const cookie = await login(env);
+  const response = await request(env, cookie, '/api/admin/history/restore', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: 'b', scope: 'outboard' }) });
+  assert.equal(response.status, 200);
+  const result = await response.json(); assert.equal(result.id, 'b'); assert.ok(result.restoredAt);
+  assert.doesNotMatch(JSON.stringify(result), /vmess|subscription:|hash-/);
+  const current = JSON.parse(cache.values.get(`subscription:v1:outboard:${domain}`)!);
+  assert.equal(current.history.id, 'b'); assert.equal(current.result.items[0].link, 'vmess://private-test-node');
+  assert.equal((await (await request(env, cookie)).json()).currentHistoryId, 'b');
+});
+test('foreign origins, missing snapshots and unconfigured storage never report success', async () => {
+  const { cache, env } = setup(); const cookie = await login(env);
+  const body = JSON.stringify({ id: 'missing', scope: 'outboard' });
+  assert.equal((await request(env, cookie, '/api/admin/history/restore', { method: 'POST', headers: { Origin: 'https://foreign.example' }, body })).status, 403);
+  assert.equal(cache.writes.length, 0);
+  assert.equal((await request(env, cookie, '/api/admin/history/restore', { method: 'POST', body })).status, 409);
+  assert.equal((await request({ ...env, HONEYBEE_CACHE: undefined }, cookie)).status, 503);
+});
+test('legacy history endpoint keeps its existing response contract', async () => {
+  const { env } = setup(); const cookie = await login(env);
+  const response = await handleAdminRequest(new Request(`${origin}/history`, { headers: { Cookie: cookie } }), env);
+  assert.equal(response.status, 200);
+  const result = await response.json(); assert.equal(result.ok, true); assert.equal(result.entries.length, 3); assert.equal(result.items, undefined);
+});
