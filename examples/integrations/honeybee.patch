diff --git a/src/workerkit-history.ts b/src/workerkit-history.ts
new file mode 100644
index 0000000..fb84cbc
--- /dev/null
+++ b/src/workerkit-history.ts
@@ -0,0 +1,71 @@
+import { bodyLimit } from 'hono/body-limit';
+import { ApiError, createServer, readPageQuery } from '@pengzhendong/worker-kit/server';
+import type { PageList, FieldIssue } from '@pengzhendong/worker-kit/contracts';
+import { getAuthConfig, isAuthenticated, isSameOriginRequest } from './admin.js';
+import { listHistoryEntries, restoreHistorySnapshot } from './cache.js';
+import { getRuntimeConfig } from './runtime.js';
+
+type Bindings = Record<string, unknown>;
+type HistoryEntry = { id: string; createdAt: string; count: number; seenCount: number };
+export const historyApp = createServer<Bindings>();
+
+// Reuse Honeybee's signed session and Origin checks. No local-auth bypass in this adapter.
+historyApp.use('*', async (c, next) => {
+  const config = getAuthConfig(c.env);
+  if (!config) throw new ApiError(503, 'auth_unconfigured', '管理员认证未配置');
+  if (!await isAuthenticated(c.req.raw, config)) throw new ApiError(401, 'unauthorized', '请先登录');
+  if (!['GET', 'HEAD'].includes(c.req.method) && !isSameOriginRequest(c.req.raw)) throw new ApiError(403, 'forbidden', '请求来源无效');
+  await next();
+});
+function scope(value: unknown) {
+  if (typeof value !== 'string' || !['inboard', 'outboard', 'all'].includes(value)) {
+    throw new ApiError(422, 'validation_failed', '请检查节点范围', [{ path: ['scope'], message: '请选择有效的节点范围' }]);
+  }
+  return value;
+}
+function runtime(env: Bindings, url: URL) {
+  try {
+    const config = getRuntimeConfig(env, url);
+    if (!config.cache) throw new ApiError(503, 'storage_unconfigured', '历史记录存储未配置');
+    return config;
+  } catch (error) {
+    if (error instanceof ApiError) throw error;
+    throw new ApiError(400, 'invalid_domain', '订阅源地址无效');
+  }
+}
+historyApp.get('/api/admin/history', async (c) => {
+  const url = new URL(c.req.url);
+  const query = readPageQuery(url.searchParams, {
+    sortFields: ['createdAt', 'id'] as const, filterFields: ['scope', 'domain'] as const,
+    defaultSort: { field: 'createdAt', order: 'desc' }, defaultPageSize: 10,
+  });
+  const selectedScope = scope(query.filters.scope ?? 'outboard');
+  const result = await listHistoryEntries(runtime(c.env, url), new URLSearchParams({ scope: selectedScope }));
+  if (!result.ok) throw new ApiError(503, 'history_unavailable', '历史记录暂时不可用');
+  // Honeybee's history index is bounded; slice this index, never an unbounded KV scan.
+  const items: HistoryEntry[] = result.entries.map((entry: HistoryEntry) => ({ id: entry.id, createdAt: entry.createdAt, count: entry.count, seenCount: entry.seenCount }));
+  const filtered = items.filter((item) => item.id.includes(query.q));
+  const { field, order } = query.sort!;
+  filtered.sort((a, b) => {
+    const compared = a[field] < b[field] ? -1 : a[field] > b[field] ? 1 : 0;
+    return (order === 'asc' ? compared : -compared) || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0);
+  });
+  return c.json({ items: filtered.slice(query.offset, query.offset + query.pageSize), total: filtered.length,
+    page: query.page, pageSize: query.pageSize, currentHistoryId: result.currentHistoryId,
+  } satisfies PageList<HistoryEntry> & { currentHistoryId: string | null });
+});
+historyApp.post('/api/admin/history/restore', bodyLimit({ maxSize: 4096, onError: () => { throw new ApiError(413, 'body_too_large', '请求过大'); } }), async (c) => {
+  let input: unknown;
+  try { input = await c.req.json(); } catch { throw new ApiError(400, 'invalid_json', '请求 JSON 无效'); }
+  if (!input || typeof input !== 'object' || Array.isArray(input)) throw new ApiError(400, 'invalid_input', '请提交 JSON 对象');
+  const body = input as Record<string, unknown>;
+  const fields: FieldIssue[] = [];
+  if (typeof body.id !== 'string' || !body.id.trim() || body.id.length > 128) fields.push({ path: ['id'], message: '请选择有效的历史版本' });
+  if (fields.length) throw new ApiError(422, 'validation_failed', '请检查表单内容', fields);
+  const selectedScope = scope(body.scope);
+  const config = runtime(c.env, new URL(c.req.url));
+  const result = await restoreHistorySnapshot(config, new URLSearchParams({ scope: selectedScope, id: body.id as string }));
+  if (!result.ok || !('restoredAt' in result) || typeof result.restoredAt !== 'string' || typeof result.id !== 'string') throw new ApiError(409, 'history_restore_failed', '历史版本不存在、已过期或恢复失败');
+  // Do not expose subscription links, tokens or internal KV keys in action results.
+  return c.json({ id: result.id, restoredAt: result.restoredAt });
+});
diff --git a/src/workerkit-worker.ts b/src/workerkit-worker.ts
new file mode 100644
index 0000000..dee6322
--- /dev/null
+++ b/src/workerkit-worker.ts
@@ -0,0 +1,11 @@
+import HoneybeeWorker from './worker.js';
+import { historyApp } from './workerkit-history';
+export { VmessProxyService } from './worker.js';
+
+export default class extends HoneybeeWorker {
+  async fetch(request: Request) {
+    const path = new URL(request.url).pathname;
+    if (path === '/api/admin/history' || path.startsWith('/api/admin/history/')) return historyApp.fetch(request, this.env);
+    return super.fetch(request);
+  }
+}
