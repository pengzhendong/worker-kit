{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dashboard",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // 0 disables automatic eligibility; cleanup is always an explicit authenticated operation.
  "vars": { "AUDIT_RETENTION_DAYS": "0" },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "ratelimits": [{ "name": "API_KEY_RATE_LIMITER", "namespace_id": "2026102403", "simple": { "limit": 120, "period": 60 } }, {
    "name": "ADMIN_LOGIN_RATE_LIMITER",
    "namespace_id": "2026102401",
    "simple": { "limit": 5, "period": 60 }
  }],
  "d1_databases": [{ "binding": "DB", "database_name": "workerkit-dashboard", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "SETTINGS" }],
  "r2_buckets": [{ "binding": "FILES" }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
