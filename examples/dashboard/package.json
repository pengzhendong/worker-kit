{
  "name": "@worker-kit/dashboard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@pengzhendong/worker-kit": "file:../..",
    "@scalar/api-reference-react": "0.9.82",
    "antd": "6.6.7",
    "hono": "4.13.13",
    "hono-openapi": "1.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "zod": "4.6.7"
  },
  "scripts": {
    "dev": "npm run db:local && vite --host 127.0.0.1",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "types": "wrangler types",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --config dist/dashboard/wrangler.json"
  },
  "devDependencies": {
    "openapi-types": "12.1.3"
  }
}
