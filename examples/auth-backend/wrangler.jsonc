{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workerkit-standard",
  "main": "worker.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "../native-dashboard/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "NATIVE_STORE",
      "id": "00000000000000000000000000000003"
    }
  ],
  "ratelimits": [
    {
      "name": "NATIVE_LOGIN_RATE_LIMITER",
      "namespace_id": "11006",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_SERVICE",
        "class_name": "WorkerKitAuthService"
      },
      {
        "name": "STANDARD_TASKS",
        "class_name": "WorkerKitStandardTasks"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkerKitAuthService", "WorkerKitStandardTasks"]
    }
  ],
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "workerkit-auth",
      "database_id": "00000000-0000-0000-0000-000000000004",
      "migrations_dir": "migrations"
    }
  ]
}
