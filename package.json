{
  "name": "@pengzhendong/worker-kit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Shared Cloudflare Workers foundations, consumed as a Git submodule.",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "examples/dashboard"
  ],
  "exports": {
    "./contracts": "./src/contracts/index.ts",
    "./server": "./src/server/index.ts",
    "./web": "./src/web/index.ts",
    "./tooling/vite": "./src/tooling/vite.ts",
    "./tooling/tsconfig.json": "./src/tooling/tsconfig.json",
    "./web/styles.css": "./src/web/styles.css"
  },
  "scripts": {
    "dev": "npm run dev --workspace @worker-kit/dashboard",
    "build": "npm run build --workspace @worker-kit/dashboard",
    "types": "npm run types --workspace @worker-kit/dashboard",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run types && npm run typecheck && npm test && npm run build && node scripts/check-production-ui.mjs && npm run deploy:dry-run",
    "deploy:dry-run": "npm run deploy:dry-run --workspace @worker-kit/dashboard",
    "test:ui": "node scripts/visual.mjs",
    "test:ui:update": "node scripts/visual.mjs --update-snapshots=all",
    "test:ui:run": "playwright test"
  },
  "peerDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@vitejs/plugin-react": "^5.2.0",
    "antd": "^6.0.0",
    "hono": "^4.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "antd": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    },
    "@cloudflare/vite-plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "antd": "6.6.7",
    "hono": "4.13.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  }
}
