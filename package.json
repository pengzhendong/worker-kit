{
  "name": "@pengzhendong/worker-kit",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Shared Cloudflare Workers foundations, consumed as a Git submodule.",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "examples/dashboard",
    "examples/nuxt-dashboard",
    "examples/prime-dashboard",
    "examples/docs",
    "examples/react-admin",
    "examples/bootstrap-admin",
    "examples/native-dashboard",
    "examples/vue-components",
    "examples/auth-backend",
    "examples/react-components"
  ],
  "exports": {
    "./client": "./src/client/index.ts",
    "./operations": "./src/server/operations.ts",
    "./modules": "./src/modules/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./server": "./src/server/index.ts",
    "./web": "./src/web/index.ts",
    "./web/api-center": "./src/web/api-center.tsx",
    "./web/scalar-reference": "./src/web/scalar-reference.tsx",
    "./web/runtime-status": "./src/web/runtime-status.tsx",
    "./tooling/vite": "./src/tooling/vite.ts",
    "./tooling/tsconfig.json": "./src/tooling/tsconfig.json",
    "./web/styles.css": "./src/web/styles.css",
    "./tooling/doctor": "./src/tooling/doctor.mjs",
    "./openapi": "./src/openapi/index.ts",
    "./runtime": "./src/server/runtime-entry.ts",
    "./http": "./src/server/streams.ts",
    "./task-sources": "./src/server/task-sources.ts",
    "./task-manager": "./src/server/task-manager.ts",
    "./task-executors": "./src/server/task-executors.ts",
    "./web/task-manager": "./src/web/task-manager.tsx",
    "./web/session": "./src/web/session.ts",
    "./web/media": "./src/web/media.tsx",
    "./web/media/styles.css": "./src/web/media.css",
    "./web/video-player": "./src/web/video-player.tsx",
    "./web/video-player/styles.css": "./src/web/video-player.css",
    "./web/virtual-grid": "./src/web/virtual-grid.tsx",
    "./native": "./src/server/native-admin.ts",
    "./vue": "./src/vue/index.ts",
    "./vue/runtime-overview": "./src/vue/RuntimeOverview.vue",
    "./vue/console-login": "./src/vue/ConsoleLogin.vue",

    "./vue/console.css": "./src/vue/console.css",
    "./management": "./src/server/management.ts",
    "./task-worker": "./src/server/task-worker.ts"
  },
  "scripts": {
    "demo": "node scripts/preview-suite.mjs",
    "demo:build": "node scripts/build-suite.mjs",
    "demo:preview": "node scripts/preview-suite.mjs --no-build",
    "dev:docs": "npm run dev --workspace @worker-kit/docs",
    "upstreams:check": "node scripts/ui-upstreams.mjs check",
    "upstreams:sync": "node scripts/ui-upstreams.mjs sync",
    "dev:nuxt": "npm run dev --workspace @worker-kit/nuxt-dashboard",
    "build:nuxt": "npm run build --workspace @worker-kit/nuxt-dashboard",
    "dev:prime": "npm run dev --workspace @worker-kit/prime-dashboard",
    "build:prime": "npm run build --workspace @worker-kit/prime-dashboard",
    "dev:vben": "node examples/vben-dashboard/setup.mjs --dev",
    "build:vben": "node examples/vben-dashboard/setup.mjs --build",
    "test:ui-suite": "node scripts/check-ui-suite.mjs",
    "check:ui-suite": "npm run demo:build && node scripts/check-ui-suite.mjs --start",
    "dev": "npm run dev:payload",
    "dev:compat": "npm run dev --workspace @worker-kit/dashboard",
    "build": "npm run build --workspace @worker-kit/dashboard",
    "types": "npm run types --workspace @worker-kit/dashboard",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run types && npm run typecheck && npm test && npm run test:tooling && npm run doctor && npm run build && node scripts/check-production-ui.mjs && npm run deploy:dry-run",
    "deploy:dry-run": "npm run deploy:dry-run --workspace @worker-kit/dashboard",
    "test:ui": "node scripts/visual.mjs",
    "test:ui:update": "node scripts/visual.mjs --update-snapshots=all",
    "test:ui:run": "playwright test",
    "doctor": "node src/tooling/doctor.mjs --project examples/dashboard",
    "test:tooling": "node --test test/tooling/*.test.mjs",
    "upgrade:check": "npm run check && npm run test:ui && npm run check:ui-suite",
    "dev:payload": "node examples/payload-dashboard/setup.mjs --preview",
    "build:payload": "node examples/payload-dashboard/setup.mjs --build",
    "test:payload": "node scripts/check-payload-demo.mjs && node scripts/check-payload-integration.mjs",
    "test:unified-worker": "node scripts/check-unified-worker.mjs",
    "test:sonic": "node scripts/check-sonic-demo.mjs",
    "demo:credentials": "npm --prefix examples/payload-dashboard/app --workspaces=false run demo:credentials",
    "create": "node src/tooling/cli.mjs create",
    "test:composition": "node scripts/check-composition.mjs",
    "test:frontend-login": "node scripts/check-frontend-login.mjs",
    "test:preview-switching": "node scripts/check-preview-switching.mjs",
    "test:workspace-layout": "node scripts/check-workspace-layout.mjs",
    "test:preview-preloading": "node scripts/check-preview-preloading.mjs",
    "build:native": "npm run build --workspace @worker-kit/native-dashboard",
    "dev:native": "npm run build:native && npm run dev --workspace @worker-kit/native-dashboard",
    "build:hub": "npm --prefix examples/nuxthub-dashboard/app --workspaces=false run build",
    "test:native-hub": "node scripts/check-native-hub.mjs",
    "check:native-hub": "npm run check --workspace @worker-kit/native-dashboard && npm --prefix examples/nuxthub-dashboard/app --workspaces=false run check",
    "test:integration": "node scripts/run-integrated-checks.mjs",
    "test:generated": "node scripts/check-generated.mjs",
    "test:management": "node scripts/check-management-parity.mjs",
    "format:check": "prettier --check examples/ui-suite/preview.js examples/ui-suite/preview-protocol.js examples/ui-suite/frame-store.js examples/ui-demo/operations.js examples/ui-demo/operations.d.ts \"examples/ui-demo/Management*.vue\" examples/ui-demo/NuxtWorkspace.vue src/server/management.ts src/server/native-admin.ts src/server/task-worker.ts src/tooling/create.mjs src/tooling/native-template.mjs src/tooling/hub-template.mjs",
    "build:pro-components": "node scripts/build-pro-components.mjs",
    "build:element": "WORKERKIT_DEMO_KIND=element vite build --config examples/vue-components/vite.config.ts",
    "build:naive": "WORKERKIT_DEMO_KIND=naive vite build --config examples/vue-components/vite.config.ts",
    "build:shadcn": "WORKERKIT_DEMO_KIND=shadcn vite build --config examples/vue-components/vite.config.ts",
    "build:pure": "node scripts/build-upstream-dashboard.mjs pure",
    "build:soybean": "node scripts/build-upstream-dashboard.mjs soybean",
    "build:mui": "WORKERKIT_DEMO_KIND=mui vite build --config examples/react-components/vite.config.ts",
    "build:mantine": "WORKERKIT_DEMO_KIND=mantine vite build --config examples/react-components/vite.config.ts",
    "build:vuetify": "WORKERKIT_DEMO_KIND=vuetify vite build --config examples/vue-components/vite.config.ts",
    "build:quasar": "WORKERKIT_DEMO_KIND=quasar vite build --config examples/vue-components/vite.config.ts",
    "build:frameworks": "node scripts/build-frameworks.mjs",
    "test:frameworks": "node scripts/check-frameworks.mjs",
    "test:standard": "node scripts/check-standard-auth.mjs && node scripts/check-standard-roles.mjs",
    "test:component-libraries": "node scripts/check-component-libraries.mjs && node scripts/check-expanded-libraries.mjs",
    "test:matrix": "node scripts/check-candidate-matrix.mjs"
  },
  "peerDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@scalar/api-reference-react": "^0.9.82",
    "@vitejs/plugin-react": "^5.2.0",
    "antd": "^6.0.0",
    "hono": "^4.13.0",
    "hono-openapi": "^1.5.0",
    "openapi-types": "^12.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^6.1.6",
    "semver": "^7.8.5",
    "vite": "^8.0.0",
    "wrangler": "^4.152.0",
    "@videojs/react": "^10.2.0",
    "wavesurfer.js": "^8.0.3",
    "@tanstack/react-virtual": "^3.14.24",
    "vue": "^3.5.0",
    "agents": "^0.32.0",
    "cron-schedule": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "antd": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    },
    "@cloudflare/vite-plugin": {
      "optional": true
    },
    "react-error-boundary": {
      "optional": true
    },
    "semver": {
      "optional": true
    },
    "wrangler": {
      "optional": true
    },
    "hono-openapi": {
      "optional": true
    },
    "@scalar/api-reference-react": {
      "optional": true
    },
    "openapi-types": {
      "optional": true
    },
    "@ant-design/icons": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "@videojs/react": {
      "optional": true
    },
    "wavesurfer.js": {
      "optional": true
    },
    "@tanstack/react-virtual": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "agents": {
      "optional": true
    },
    "cron-schedule": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@videojs/react": "10.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "antd": "6.6.7",
    "hono": "4.13.13",
    "hono-openapi": "1.5.0",
    "openapi-types": "12.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "semver": "7.8.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wavesurfer.js": "8.0.3",
    "wrangler": "4.152.0",
    "@tanstack/react-virtual": "3.14.24",
    "agents": "0.32.0",
    "cron-schedule": "6.0.0",
    "@scalar/api-reference": "1.75.1",
    "prettier": "3.6.2",
    "unplugin-vue-components": "32.1.0"
  },
  "bin": {
    "workerkit": "./src/tooling/cli.mjs"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    },
    "@cloudflare/vitest-plugin": {
      "zod": "4.6.7"
    }
  }
}
